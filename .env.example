# ==============================================================================
# CHEF MOM — ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# Chef Mom functions out-of-the-box using its built-in database of 20,500+ curated recipes.
#
# OPTIONAL AI GENERATION:
# Set GEMINI_API_KEY (or GOOGLE_API_KEY) in Vercel Project Settings > Environment Variables
# to enable on-demand creative recipe generation powered by Google Gemini.
# If omitted, Chef Mom seamlessly relies on the 20,500+ curated recipe matching engine.
#
GEMINI_API_KEY=your_gemini_api_key_here
